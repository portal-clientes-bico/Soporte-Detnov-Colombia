# Copiar a .env.local y completar con valores reales (.env.local nunca va a git).

# Requerido siempre: clave de la API de Anthropic para el ChatBot.
ANTHROPIC_API_KEY=

# Solo para despliegue en la nube (Vercel). Si se dejan vacios, la herramienta sigue
# funcionando en modo local: guarda todo en data/db.json y data/uploads* en disco, igual
# que siempre. Se llenan con los valores que da Vercel al crear el Postgres (integracion
# Neon) y el Blob store del proyecto -- correr `vercel env pull` en vez de llenarlos a mano,
# ya se genera solo con los correctos (incluye VERCEL_OIDC_TOKEN, que las credenciales del
# Blob store nuevo usan en vez de un BLOB_READ_WRITE_TOKEN estatico).
POSTGRES_URL=
BLOB_STORE_ID=
